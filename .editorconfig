# EditorConfig configuration for Catet AI
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Kotlin & Gradle Kotlin DSL
[*.{kt,kts}]
indent_style = space
indent_size = 4
continuation_indent_size = 4
max_line_length = 120
ij_kotlin_name_count_to_use_star_import = 999
ij_kotlin_name_count_to_use_star_import_for_members = 999
ij_kotlin_packages_to_use_import_on_demand = unset
ij_kotlin_imports_layout = *,|,java.**,|,javax.**,|,kotlin.**,|,^

# Android XML & Layouts
[*.xml]
indent_style = space
indent_size = 4

# Web / Data / Config formats
[*.{json,yaml,yml,toml}]
indent_style = space
indent_size = 2

# Markdown documentation (preserve trailing spaces for line breaks)
[*.md]
trim_trailing_whitespace = false
